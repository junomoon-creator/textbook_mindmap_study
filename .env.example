# Google Cloud Storage (already created by the user)
STORAGE_BACKEND=gcs
GCS_BUCKET=mindmapping-study-data-juno2026
GCS_PREFIX=mindmapping_study

# Claude API: paste your key locally, NEVER commit .env
ANTHROPIC_API_KEY=
# Use an actual model ID listed in your Anthropic Console (example only)
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_MAX_TOKENS=8192

# Optional: local development without GCS
LOCAL_DATA_DIR=./local_data
